{
  "name": "theschneider.hair",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
  
    "dev":              "vite --port=3000 --host=0.0.0.0",

    "build":            "vite build",
    "build:release":    "vite build --mode release",
    
    "deploy:hosting:preview":  "pnpm run build:release && firebase hosting:channel:deploy preview -P release",
    "deploy:hosting:live":     "pnpm run build:release && firebase deploy --only hosting -P release",
   
    "lint": "tsc --noEmit"

  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "firebase-tools": "^15.16.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.8.3",
    "vite": "^6.4.2"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "glob": "*",
      "json-ptr": "*",
      "node-domexception": "*",
      "uuid": "*"
    }
  }
}
